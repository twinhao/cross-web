# ── 後端 API ──
# Cross 後端本地跑 8001（8000 被其他服務佔用）
NEXT_PUBLIC_API_URL=http://localhost:8001
BACKEND_URL=http://localhost:8001
# Cloudflare 預覽僅允許讀取正式 API；正式 Worker 才設定 true。
ALLOW_PRODUCTION_WRITES=false

# ── 第三方登入 ──
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# ── 夥伴加入通知信（Resend）──
RESEND_API_KEY=
JOIN_NOTIFY_EMAIL=
JOIN_NOTIFY_FROM=

# ── 造訪人數的 IP 雜湊 salt（正式環境務必設定）──
# 原始 IP 僅在 Web 端取出，依台北日期加鹽雜湊後才送往後端。
# 未設定時停用瀏覽統計；請保留既有正式 salt，不放入前端公開變數。
VISITOR_HASH_SALT=

# ── 其他 ──
NEXT_PUBLIC_USE_MOCK_DATA=false
# Google Search Console 網站擁有權驗證
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
