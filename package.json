{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "sync:developers": "node scripts/sync-developer-content.mjs",
    "deploy:preview": "pnpm build && wrangler deploy --env \"\"",
    "deploy:production": "pnpm build && wrangler deploy --env production",
    "preview:worker": "wrangler dev",
    "check:worker": "wrangler deploy --env \"\" --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.72.0",
    "bits-ui": "^2.21.0",
    "cf-workers-og": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "marked": "^18.2.0",
    "mode-watcher": "^1.1.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "shadcn-svelte": "1.8.1",
    "sharp": "0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.17 <25"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
